{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumeTrace",
  "version": "0.1.0",
  "identifier": "com.lumetrace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "LumeTrace",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
